# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of reverse proxies in front of the API (Render = 1, local = 0)
TRUST_PROXY=0

# ─── Database ──────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/doctor-tracker
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doctor-tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/doctor-tracker

# ─── CORS ──────────────────────────────────────────────────
# Comma-separated. The web app proxies /api through Next.js, so this only matters for direct calls.
CORS_ORIGINS=http://localhost:3000

# ─── Auth ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# ─── Seed (pnpm seed) ──────────────────────────────────────
SEED_ADMIN_EMAIL=admin@doctortracker.dev
SEED_ADMIN_PASSWORD=Admin@12345
